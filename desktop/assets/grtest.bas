10 REM BASIC GRAPHICS SHOWCASE
20 REM Creates a small responsive control dashboard.
30 W = GFX_WIDTH()
40 H = GFX_HEIGHT()
50 S = GFX_SCREEN()
60 IF W = 0 OR H = 0 THEN PRINT "Graphics display is not ready": END

100 REM Screen background and main panel
110 GFX_BG_COLOR(S, GFX_RGB(&H101820))
120 PANEL = GFX_CREATE("OBJ", S)
130 GFX_SET_SIZE(PANEL, W - 40, H - 40)
140 GFX_ALIGN(PANEL, "CENTER", 0, 0)
150 GFX_BG_COLOR(PANEL, GFX_RGB(&H1F3040))
160 GFX_RADIUS(PANEL, 18)

200 REM Header
210 TITLE = GFX_CREATE("LABEL", PANEL)
220 GFX_TEXT(TITLE, "BASIC CONTROL DECK")
230 GFX_SET_SIZE(TITLE, W - 80, 42)
240 GFX_ALIGN(TITLE, "TOP_MID", 0, 18)
250 GFX_BG_COLOR(TITLE, GFX_RGB(&H2E7188))
260 GFX_RADIUS(TITLE, 10)
270 GFX_FONT(TITLE, "MONTSERRAT_16")

300 SUBTITLE = GFX_CREATE("LABEL", PANEL)
310 GFX_TEXT(SUBTITLE, "LVGL GRAPHICS / CM55")
320 GFX_SET_SIZE(SUBTITLE, W - 100, 28)
330 GFX_ALIGN(SUBTITLE, "TOP_MID", 0, 72)
340 GFX_BG_COLOR(SUBTITLE, GFX_RGB(&H244454))
350 GFX_RADIUS(SUBTITLE, 7)

400 REM Status card
410 STATUS = GFX_CREATE("OBJ", PANEL)
420 GFX_SET_SIZE(STATUS, W - 100, 86)
430 GFX_ALIGN(STATUS, "TOP_MID", 0, 116)
440 GFX_BG_COLOR(STATUS, GFX_RGB(&H16252D))
450 GFX_RADIUS(STATUS, 12)
460 STATUS_TEXT = GFX_CREATE("LABEL", STATUS)
470 GFX_TEXT(STATUS_TEXT, "SYSTEM STATUS   ONLINE")
480 GFX_SET_SIZE(STATUS_TEXT, W - 130, 30)
490 GFX_ALIGN(STATUS_TEXT, "TOP_LEFT", 14, 12)
500 GFX_BG_COLOR(STATUS_TEXT, GFX_RGB(&H238B72))
510 GFX_RADIUS(STATUS_TEXT, 6)
520 INFO = GFX_CREATE("LABEL", STATUS)
530 GFX_TEXT(INFO, "DISPLAY READY   |   TOUCH READY")
540 GFX_SET_SIZE(INFO, W - 130, 25)
550 GFX_ALIGN(INFO, "TOP_LEFT", 14, 50)
560 GFX_BG_COLOR(INFO, GFX_RGB(&H314552))
570 GFX_RADIUS(INFO, 5)

600 REM Slider card
610 SLIDER_CARD = GFX_CREATE("OBJ", PANEL)
620 GFX_SET_SIZE(SLIDER_CARD, (W - 120) / 2, 140)
630 GFX_ALIGN(SLIDER_CARD, "BOTTOM_LEFT", 20, -20)
640 GFX_BG_COLOR(SLIDER_CARD, GFX_RGB(&H243D4A))
650 GFX_RADIUS(SLIDER_CARD, 12)
660 SLIDER_LABEL = GFX_CREATE("LABEL", SLIDER_CARD)
670 GFX_TEXT(SLIDER_LABEL, "BRIGHTNESS")
680 GFX_SET_SIZE(SLIDER_LABEL, (W - 160) / 2, 28)
690 GFX_ALIGN(SLIDER_LABEL, "TOP_LEFT", 14, 12)
700 GFX_BG_COLOR(SLIDER_LABEL, GFX_RGB(&H315A68))
710 GFX_RADIUS(SLIDER_LABEL, 5)
720 SLIDER = GFX_CREATE("SLIDER", SLIDER_CARD)
730 GFX_SET_SIZE(SLIDER, (W - 160) / 2, 30)
740 GFX_ALIGN(SLIDER, "TOP_LEFT", 14, 58)
750 GFX_RANGE(SLIDER, 0, 100)
760 GFX_VALUE(SLIDER, 72)
770 GFX_COLOR_SET(SLIDER, GFX_RGB(&H4CC2A5))

800 REM Switch card
810 SWITCH_CARD = GFX_CREATE("OBJ", PANEL)
820 GFX_SET_SIZE(SWITCH_CARD, (W - 120) / 2, 140)
830 GFX_ALIGN(SWITCH_CARD, "BOTTOM_RIGHT", -20, -20)
840 GFX_BG_COLOR(SWITCH_CARD, GFX_RGB(&H243D4A))
850 GFX_RADIUS(SWITCH_CARD, 12)
860 SWITCH_LABEL = GFX_CREATE("LABEL", SWITCH_CARD)
870 GFX_TEXT(SWITCH_LABEL, "NIGHT MODE")
880 GFX_SET_SIZE(SWITCH_LABEL, (W - 160) / 2, 28)
890 GFX_ALIGN(SWITCH_LABEL, "TOP_LEFT", 14, 12)
900 GFX_BG_COLOR(SWITCH_LABEL, GFX_RGB(&H315A68))
910 GFX_RADIUS(SWITCH_LABEL, 5)
920 TOGGLE = GFX_CREATE("SWITCH", SWITCH_CARD)
930 GFX_ALIGN(TOGGLE, "CENTER", 0, 20)
940 GFX_CHECKED(TOGGLE, 0)
950 GFX_ENABLED(TOGGLE, 1)

1000 REM Footer action button
1010 BUTTON = GFX_CREATE("BUTTON", PANEL)
1020 GFX_SET_SIZE(BUTTON, W - 100, 38)
1030 GFX_ALIGN(BUTTON, "BOTTOM_MID", 0, -174)
1040 GFX_TEXT(BUTTON, "LAUNCH DIAGNOSTICS")
1050 GFX_BG_COLOR(BUTTON, GFX_RGB(&H2E7188))
1060 GFX_RADIUS(BUTTON, 8)
1070 GFX_FONT(BUTTON, "MONTSERRAT_14")
1080 GFX_REFRESH()
1090 PRINT "Graphics showcase ready: "; W; " X "; H
