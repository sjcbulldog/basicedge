10 REM GRTREK - GRAPHICAL SUPER STAR TREK FOR BASICEDGE
20 REM Port of trek.bas (Super Star Trek, 1978) to the GFX_* LVGL display.
30 REM Flip a command switch on the display, or press its key on the
40 REM console: N=NAV L=LRS P=PHA T=TOR S=SHE D=DAM A=AIM X=XXX.
50 REM The sliders set the course, warp factor and energy units. Keys 1-9
60 REM set the course; [ ] < > - + nudge the course, warp and units.
70 REM If a run is interrupted, type GFX CLEAR before running it again.
100 IF GFX_WIDTH()=0 THEN PRINT "Graphics display is not ready":END
110 PRINT "GRTREK - SUPER STAR TREK ON THE GRAPHICS DISPLAY"
120 PRINT "Keys: N=NAV L=LRS P=PHA T=TOR S=SHE D=DAM A=AIM X=XXX  1-9=COURSE"
125 PRINT "If a run is interrupted, type GFX CLEAR before running it again."
130 RANDOMIZE TIMER*1000
140 DIM G(8,8),C(9,2),K(3,3),Z(8,8),D(8),HK(3),HS(8),HC(8),HL(4),HB(8),HV(3),L$(4)
150 NL$=CHR$(10):Z$="                         ":C$="GREEN"
160 FOR I=1 TO 9:C(I,1)=0:C(I,2)=0:NEXT I
170 C(3,1)=-1:C(2,1)=-1:C(4,1)=-1:C(4,2)=-1:C(5,2)=-1:C(6,2)=-1
180 C(1,2)=1:C(2,2)=1:C(6,1)=1:C(7,1)=1:C(8,1)=1:C(8,2)=1:C(9,2)=1
190 DEF FND(D)=SQR((K(I,1)-S1)^2+(K(I,2)-S2)^2)
200 DEF FNR(R)=INT(RND(R)*7.98+1.01)
210 GOSUB 10000
290 REM NEW GAME: SETUP WHAT EXISTS IN THE GALAXY
300 T=INT(RND(1)*20+20)*100:T0=T:T9=25+INT(RND(1)*10):D0=0:E=3000:E0=E
310 P=10:P0=P:S9=200:S=0:B9=0:K9=0:MV=0:RA=0:AI=0:ED=0
320 Q1=FNR(1):Q2=FNR(1):S1=FNR(1):S2=FNR(1)
330 FOR I=1 TO 8:D(I)=0:NEXT I
340 FOR I=1 TO 8:FOR J=1 TO 8:K3=0:Z(I,J)=0:R1=RND(1)
350 IF R1>.98 THEN K3=3:K9=K9+3:GOTO 380
360 IF R1>.95 THEN K3=2:K9=K9+2:GOTO 380
370 IF R1>.80 THEN K3=1:K9=K9+1
380 B3=0:IF RND(1)>.96 THEN B3=1:B9=B9+1
390 G(I,J)=K3*100+B3*10+FNR(1):NEXT J:NEXT I:IF K9>T9 THEN T9=K9+1
400 IF B9<>0 THEN 430
410 IF G(Q1,Q2)<200 THEN G(Q1,Q2)=G(Q1,Q2)+120:K9=K9+1
420 B9=1:G(Q1,Q2)=G(Q1,Q2)+10:Q1=FNR(1):Q2=FNR(1)
430 K7=K9:X$="S":IF B9=1 THEN X$=""
440 M$="YOUR ORDERS: DESTROY THE "+STR$(K9)+" KLINGON WARSHIPS BEFORE THEY ATTACK FEDERATION HEADQUARTERS":GOSUB 8000
450 M$="ON STARDATE "+STR$(T0+T9)+".  THIS GIVES YOU "+STR$(T9)+" DAYS.  THERE ARE "+STR$(B9)+" STARBASE"+X$+" FOR RESUPPLYING YOUR SHIP.":GOSUB 8000
490 REM HERE ANY TIME A NEW QUADRANT IS ENTERED
500 Z4=Q1:Z5=Q2:K3=0:B3=0:S3=0:G5=0:D4=.5*RND(1):Z(Q1,Q2)=G(Q1,Q2):AI=0
510 GOSUB 9030:IF T0<>T THEN M$="NOW ENTERING "+G2$+" QUADRANT . . .":GOSUB 8000:GOTO 530
520 M$="YOUR MISSION BEGINS WITH YOUR STARSHIP LOCATED IN THE GALACTIC QUADRANT '"+G2$+"'.":GOSUB 8000
530 K3=INT(G(Q1,Q2)*.01):B3=INT(G(Q1,Q2)*.1)-10*K3
540 S3=G(Q1,Q2)-100*K3-10*B3:IF K3=0 THEN 570
550 M$="COMBAT AREA      CONDITION RED":IF S<=200 THEN M$=M$+"      SHIELDS DANGEROUSLY LOW"
560 GOSUB 8000
570 FOR I=1 TO 3:K(I,1)=0:K(I,2)=0:K(I,3)=0:NEXT I:Q$=Z$+Z$+Z$+Z$+Z$+Z$+Z$+LEFT$(Z$,17)
575 REM POSITION ENTERPRISE, THEN PLACE KLINGONS, STARBASE AND STARS
580 A$="<*>":Z1=S1:Z2=S2:GOSUB 8670:IF K3<1 THEN 610
590 FOR I=1 TO K3:GOSUB 8590:A$="+K+":Z1=R1:Z2=R2
600 GOSUB 8670:K(I,1)=R1:K(I,2)=R2:K(I,3)=S9*(0.5+RND(1)):NEXT I
610 IF B3<1 THEN 630
620 GOSUB 8590:A$=">!<":Z1=R1:B4=R1:Z2=R2:B5=R2:GOSUB 8670
630 FOR I=1 TO S3:GOSUB 8590:A$=" * ":Z1=R1:Z2=R2:GOSUB 8670:NEXT I
640 GOSUB 6430
645 REM COMMAND LOOP
650 IF S+E>10 THEN IF E>10 OR D(7)=0 THEN 700
660 M$="** FATAL ERROR **   YOU'VE JUST STRANDED YOUR SHIP IN SPACE.":GOSUB 8000
670 M$="YOU HAVE INSUFFICIENT MANEUVERING ENERGY, AND SHIELD CONTROL IS PRESENTLY INCAPABLE":GOSUB 8000
680 M$="OF CROSS-CIRCUITING TO ENGINE ROOM!!":GOSUB 8000:GOTO 6220
700 GOSUB 7000:GOSUB 7600:IF I<>6 THEN RA=0:MV=0
710 ON I GOTO 2300,4000,4260,4700,5530,5690,8070,6270
720 M$="KEYS: N=NAV L=LRS P=PHA T=TOR S=SHE D=DAM A=AIM X=XXX   1-9 [ ]=COURSE   < >=WARP   - +=UNITS":GOSUB 8000:GOTO 700
2290 REM COURSE CONTROL (NAV) - COURSE AND WARP COME FROM THE SLIDERS
2300 GOSUB 7650:C1=V1/10:IF C1=9 THEN C1=1
2310 W1=V2/10:IF D(1)<0 AND W1>.2 THEN M$="WARP ENGINES ARE DAMAGED.  MAXIMUM SPEED = WARP 0.2":GOSUB 8000:GOTO 650
2320 IF W1<=0 OR W1>8 THEN M$="CHIEF ENGINEER SCOTT REPORTS 'THE ENGINES WON'T TAKE WARP "+STR$(W1)+"!'":GOSUB 8000:GOTO 650
2330 N=INT(W1*8+.5):IF E-N>=0 THEN 2590
2340 M$="ENGINEERING REPORTS 'INSUFFICIENT ENERGY AVAILABLE FOR MANEUVERING AT WARP "+STR$(W1)+"!'":GOSUB 8000
2350 IF S<N-E OR D(7)<0 THEN 650
2360 M$="DEFLECTOR CONTROL ROOM ACKNOWLEDGES "+STR$(INT(S))+" UNITS OF ENERGY PRESENTLY DEPLOYED TO SHIELDS.":GOSUB 8000:GOTO 650
2580 REM KLINGONS MOVE/FIRE ON MOVING STARSHIP . . .
2590 FOR I=1 TO K3:IF K(I,3)=0 THEN 2700
2610 A$="   ":Z1=K(I,1):Z2=K(I,2):GOSUB 8670:GOSUB 8590
2660 K(I,1)=Z1:K(I,2)=Z2:A$="+K+":GOSUB 8670
2700 NEXT I:GOSUB 7100:GOSUB 6000:D1=0:D6=W1:IF W1>=1 THEN D6=1
2770 FOR I=1 TO 8:IF D(I)>=0 THEN 2880
2790 D(I)=D(I)+D6:IF D(I)>-.1 AND D(I)<0 THEN D(I)=-.1:GOTO 2880
2800 IF D(I)<0 THEN 2880
2840 R1=I:GOSUB 8790:M$="DAMAGE CONTROL REPORT:  "+G2$+" REPAIR COMPLETED.":GOSUB 8000
2880 NEXT I:IF RND(1)>.2 THEN 3070
2910 R1=FNR(1):IF RND(1)>=.6 THEN 3000
2930 D(R1)=D(R1)-(RND(1)*5+1):GOSUB 8790:M$="DAMAGE CONTROL REPORT:  "+G2$+" DAMAGED":GOSUB 8000:GOTO 3070
3000 D(R1)=D(R1)+RND(1)*3+1:GOSUB 8790:M$="DAMAGE CONTROL REPORT:  "+G2$+" STATE OF REPAIR IMPROVED":GOSUB 8000
3060 REM BEGIN MOVING STARSHIP
3070 A$="   ":Z1=INT(S1):Z2=INT(S2):GOSUB 8670
3110 X1=C(C1,1)+(C(C1+1,1)-C(C1,1))*(C1-INT(C1)):X=S1:Y=S2
3140 X2=C(C1,2)+(C(C1+1,2)-C(C1,2))*(C1-INT(C1)):Q4=Q1:Q5=Q2
3170 FOR I=1 TO N:S1=S1+X1:S2=S2+X2:IF S1<1 OR S1>=9 OR S2<1 OR S2>=9 THEN 3500
3240 S8=INT(S1)*24+INT(S2)*3-26:IF MID$(Q$,S8,2)="  " THEN 3360
3320 S1=INT(S1-X1):S2=INT(S2-X2):M$="WARP ENGINES SHUT DOWN AT SECTOR "+STR$(S1)+" , "+STR$(S2)+" DUE TO BAD NAVIGATION":GOSUB 8000:GOTO 3370
3360 U1=INT(S1):U2=INT(S2):U=EH:U5=34:GOSUB 7190:SLEEP .05:NEXT I:S1=INT(S1):S2=INT(S2)
3370 A$="<*>":Z1=INT(S1):Z2=INT(S2):GOSUB 8670:GOSUB 3910:T8=1
3430 IF W1<1 THEN T8=.1*INT(10*W1)
3450 T=T+T8:IF T>T0+T9 THEN 6220
3480 GOSUB 6430:GOTO 650
3490 REM EXCEEDED QUADRANT LIMITS
3500 X=8*Q1+X+N*X1:Y=8*Q2+Y+N*X2:Q1=INT(X/8):Q2=INT(Y/8):S1=INT(X-Q1*8)
3550 S2=INT(Y-Q2*8):IF S1=0 THEN Q1=Q1-1:S1=8
3590 IF S2=0 THEN Q2=Q2-1:S2=8
3620 X5=0:IF Q1<1 THEN X5=1:Q1=1:S1=1
3670 IF Q1>8 THEN X5=1:Q1=8:S1=8
3710 IF Q2<1 THEN X5=1:Q2=1:S2=1
3750 IF Q2>8 THEN X5=1:Q2=8:S2=8
3790 IF X5=0 THEN 3860
3800 M$="LT. UHURA REPORTS MESSAGE FROM STARFLEET COMMAND:  'PERMISSION TO ATTEMPT CROSSING":GOSUB 8000
3810 M$="OF GALACTIC PERIMETER IS HEREBY *DENIED*.  SHUT DOWN YOUR ENGINES.'":GOSUB 8000
3830 M$="CHIEF ENGINEER SCOTT REPORTS  'WARP ENGINES SHUT DOWN AT SECTOR "+STR$(S1)+" , "+STR$(S2)+" OF QUADRANT "+STR$(Q1)+" , "+STR$(Q2)+".'":GOSUB 8000
3850 IF T>T0+T9 THEN 6220
3860 IF 8*Q1+Q2=8*Q4+Q5 THEN 3370
3870 T=T+1:GOSUB 3910:GOTO 500
3900 REM MANEUVER ENERGY S/R **
3910 E=E-N-10:IF E>=0 THEN RETURN
3930 M$="SHIELD CONTROL SUPPLIES ENERGY TO COMPLETE THE MANEUVER.":GOSUB 8000
3940 S=S+E:E=0:IF S<=0 THEN S=0
3980 RETURN
3990 REM LONG RANGE SENSOR SCAN - RESULTS GO INTO THE GALACTIC RECORD MAP
4000 IF D(3)<0 THEN M$="LONG RANGE SENSORS ARE INOPERABLE":GOSUB 8000:GOTO 650
4010 FOR I=Q1-1 TO Q1+1:FOR J=Q2-1 TO Q2+1
4020 IF I>0 AND I<9 AND J>0 AND J<9 THEN Z(I,J)=G(I,J)
4030 NEXT J:NEXT I:MV=0
4040 M$="LONG RANGE SCAN FOR QUADRANT "+STR$(Q1)+" , "+STR$(Q2)+" ADDED TO THE GALACTIC RECORD.":GOSUB 8000:GOTO 650
4250 REM PHASER CONTROL - ENERGY COMES FROM THE UNITS SLIDER
4260 IF D(4)<0 THEN M$="PHASERS INOPERATIVE":GOSUB 8000:GOTO 650
4265 IF K3>0 THEN 4330
4270 M$="SCIENCE OFFICER SPOCK REPORTS  'SENSORS SHOW NO ENEMY SHIPS IN THIS QUADRANT'":GOSUB 8000:GOTO 650
4330 IF D(8)<0 THEN M$="COMPUTER FAILURE HAMPERS ACCURACY":GOSUB 8000
4370 GOSUB 7650:X=V3:IF X<=0 THEN M$="SET THE UNITS SLIDER TO THE NUMBER OF UNITS TO FIRE.":GOSUB 8000:GOTO 650
4400 IF E-X<0 THEN M$="PHASERS LOCKED ON TARGET;  ENERGY AVAILABLE = "+STR$(INT(E))+" UNITS":GOSUB 8000:GOTO 650
4410 E=E-X:IF D(7)<0 THEN X=X*RND(1)
4450 H1=INT(X/K3):FOR I=1 TO 3:IF K(I,3)<=0 THEN 4670
4480 H=INT((H1/FND(0))*(RND(1)+2)):IF H>.15*K(I,3) THEN 4530
4500 M$="SENSORS SHOW NO DAMAGE TO ENEMY AT "+STR$(K(I,1))+" , "+STR$(K(I,2)):GOSUB 8000:GOTO 4670
4530 K(I,3)=K(I,3)-H:U=I:GOSUB 7200:M$=STR$(H)+" UNIT HIT ON KLINGON AT SECTOR "+STR$(K(I,1))+" , "+STR$(K(I,2))
4550 IF K(I,3)<=0 THEN GOSUB 8000:M$="*** KLINGON DESTROYED ***":GOSUB 8000:GOTO 4580
4560 M$=M$+"   (SENSORS SHOW "+STR$(INT(K(I,3)))+" UNITS REMAINING)":GOSUB 8000:GOTO 4670
4580 K3=K3-1:K9=K9-1:Z1=K(I,1):Z2=K(I,2):A$="   ":GOSUB 8670
4650 K(I,3)=0:G(Q1,Q2)=G(Q1,Q2)-100:Z(Q1,Q2)=G(Q1,Q2):IF K9<=0 THEN 6370
4670 NEXT I:GOSUB 7100:GOSUB 6000:GOTO 650
4690 REM PHOTON TORPEDOES - COURSE COMES FROM THE COURSE SLIDER
4700 IF P<=0 THEN M$="ALL PHOTON TORPEDOES EXPENDED":GOSUB 8000:GOTO 650
4730 IF D(5)<0 THEN M$="PHOTON TUBES ARE NOT OPERATIONAL":GOSUB 8000:GOTO 650
4760 GOSUB 7650:C1=V1/10:IF C1=9 THEN C1=1
4850 X1=C(C1,1)+(C(C1+1,1)-C(C1,1))*(C1-INT(C1)):E=E-2:P=P-1
4860 X2=C(C1,2)+(C(C1+1,2)-C(C1,2))*(C1-INT(C1)):X=S1:Y=S2:T$="TORPEDO TRACK:"
4920 X=X+X1:Y=Y+X2:X3=INT(X+.5):Y3=INT(Y+.5)
4960 IF X3<1 OR X3>8 OR Y3<1 OR Y3>8 THEN 5490
5000 T$=T$+"  "+STR$(X3)+","+STR$(Y3):U1=X3:U2=Y3:GOSUB 7180:A$="   ":Z1=X:Z2=Y:GOSUB 8830
5050 IF Z3<>0 THEN 4920
5055 GFX_HIDE(TP):M$=T$:GOSUB 8000
5060 A$="+K+":Z1=X:Z2=Y:GOSUB 8830:IF Z3=0 THEN 5210
5110 M$="*** KLINGON DESTROYED ***":GOSUB 8000:K3=K3-1:K9=K9-1:IF K9<=0 THEN 6370
5150 FOR I=1 TO 3:IF X3=K(I,1) AND Y3=K(I,2) THEN 5190
5180 NEXT I:I=3
5190 K(I,3)=0:GOTO 5430
5210 A$=" * ":Z1=X:Z2=Y:GOSUB 8830:IF Z3=0 THEN 5280
5260 M$="STAR AT "+STR$(X3)+" , "+STR$(Y3)+" ABSORBED TORPEDO ENERGY.":GOSUB 8000:GOSUB 6000:GOTO 650
5280 A$=">!<":Z1=X:Z2=Y:GOSUB 8830:IF Z3=0 THEN 4920
5330 M$="*** STARBASE DESTROYED ***":GOSUB 8000:B3=B3-1:B9=B9-1
5360 IF B9>0 OR K9>T-T0-T9 THEN 5400
5370 M$="THAT DOES IT, CAPTAIN!!  YOU ARE HEREBY RELIEVED OF COMMAND":GOSUB 8000
5380 M$="AND SENTENCED TO 99 STARDATES AT HARD LABOR ON CYGNUS 12!!":GOSUB 8000:GOTO 6270
5400 M$="STARFLEET COMMAND REVIEWING YOUR RECORD TO CONSIDER COURT MARTIAL!":GOSUB 8000:D0=0
5430 Z1=X:Z2=Y:A$="   ":GOSUB 8670
5470 G(Q1,Q2)=K3*100+B3*10+S3:Z(Q1,Q2)=G(Q1,Q2):GOSUB 7100:GOSUB 6000:GOTO 650
5490 GFX_HIDE(TP):M$=T$+"   TORPEDO MISSED":GOSUB 8000:GOSUB 6000:GOTO 650
5520 REM SHIELD CONTROL - THE UNITS SLIDER GIVES THE NEW SHIELD LEVEL
5530 IF D(7)<0 THEN M$="SHIELD CONTROL INOPERABLE":GOSUB 8000:GOTO 650
5560 GOSUB 7650:X=V3
5580 IF X<0 OR S=X THEN M$="<SHIELDS UNCHANGED>":GOSUB 8000:GOTO 650
5590 IF X<=E+S THEN 5630
5600 M$="SHIELD CONTROL REPORTS  'THIS IS NOT THE FEDERATION TREASURY.'   ENERGY AVAILABLE = "+STR$(INT(E+S)):GOSUB 8000
5610 M$="<SHIELDS UNCHANGED>":GOSUB 8000:GOTO 650
5630 E=E+S-X:S=X:M$="DEFLECTOR CONTROL ROOM REPORT:  'SHIELDS NOW AT "+STR$(INT(S))+" UNITS PER YOUR COMMAND.'":GOSUB 8000:GOTO 650
5680 REM DAMAGE CONTROL - THE REPORT IS SHOWN IN THE MAP PANEL
5690 IF D(6)<0 THEN M$="DAMAGE CONTROL REPORT NOT AVAILABLE":GOSUB 8000
5695 IF D(6)>=0 THEN MV=1
5700 IF D0=0 THEN 650
5720 D3=0:FOR I=1 TO 8:IF D(I)<0 THEN D3=D3+.1
5760 NEXT I:IF D3=0 THEN 650
5780 D3=D3+D4:IF D3>=1 THEN D3=.9
5790 IF RA=1 THEN 5870
5810 RA=1:M$="TECHNICIANS STANDING BY TO EFFECT REPAIRS TO YOUR SHIP;":GOSUB 8000
5820 M$="ESTIMATED TIME TO REPAIR: "+STR$(.01*INT(100*D3))+" STARDATES.   FLIP DAM AGAIN TO AUTHORIZE THE REPAIR ORDER.":GOSUB 8000:GOTO 650
5870 RA=0:FOR I=1 TO 8:IF D(I)<0 THEN D(I)=0
5890 NEXT I:T=T+D3+.1:M$="REPAIR ORDER COMPLETED.":GOSUB 8000:GOTO 650
5990 REM KLINGONS SHOOTING
6000 IF K3<=0 THEN RETURN
6010 IF D0<>0 THEN M$="STARBASE SHIELDS PROTECT THE ENTERPRISE":GOSUB 8000:RETURN
6040 FOR I=1 TO 3:IF K(I,3)<=0 THEN 6200
6060 H=INT((K(I,3)/FND(1))*(2+RND(1))):S=S-H:K(I,3)=K(I,3)/(3+RND(0)):GOSUB 7210
6080 M$=STR$(H)+" UNIT HIT ON ENTERPRISE FROM SECTOR "+STR$(K(I,1))+" , "+STR$(K(I,2))
6090 IF S<=0 THEN GOSUB 8000:GOTO 6240
6100 M$=M$+"      <SHIELDS DOWN TO "+STR$(INT(S))+" UNITS>":GOSUB 8000:IF H<20 THEN 6200
6120 IF RND(1)>.6 OR H/S<=.02 THEN 6200
6140 R1=FNR(1):D(R1)=D(R1)-H/S-.5*RND(1):GOSUB 8790
6170 M$="DAMAGE CONTROL REPORTS '"+G2$+" DAMAGED BY THE HIT'":GOSUB 8000
6200 NEXT I:RETURN
6210 REM END OF GAME
6220 M$="IT IS STARDATE "+STR$(INT(T*10)/10):GOSUB 8000:GOTO 6270
6240 ED=1:M$="THE ENTERPRISE HAS BEEN DESTROYED.  THE FEDERATION WILL BE CONQUERED":GOSUB 8000:GOTO 6220
6270 M$="THERE WERE "+STR$(K9)+" KLINGON BATTLE CRUISERS LEFT AT THE END OF YOUR MISSION.":GOSUB 8000
6290 GOSUB 7000:IF B9=0 THEN 6360
6310 M$="THE FEDERATION IS IN NEED OF A NEW STARSHIP COMMANDER FOR A SIMILAR MISSION -- IF THERE IS A":GOSUB 8000
6320 M$="VOLUNTEER, LET HIM STEP FORWARD AND FLIP NAV (OR PRESS N).   FLIP XXX (OR PRESS X) TO QUIT.":GOSUB 8000
6330 GOSUB 7600:IF I=1 THEN 300
6340 IF I<>8 THEN 6330
6360 M$="END OF MISSION.   PRESS ANY KEY OR FLIP ANY SWITCH TO CLOSE THE DISPLAY.":GOSUB 8000
6365 GOSUB 7600:GFX_DELETE(RT):GFX_BG_COLOR(SC,GFX_RGB(&HADD8E6)):PRINT "GRTREK ENDED.":END
6370 M$="CONGRATULATIONS, CAPTAIN!  THE LAST KLINGON BATTLE CRUISER MENACING THE FEDERATION":GOSUB 8000
6380 M$="HAS BEEN DESTROYED.":GOSUB 8000
6400 M$="YOUR EFFICIENCY RATING IS "+STR$(INT(1000*(K7/(T-T0))^2)):GOSUB 8000:GOTO 6290
6420 REM DOCKING CHECK AND CONDITION
6430 D0=0:FOR I=S1-1 TO S1+1:FOR J=S2-1 TO S2+1
6450 IF INT(I+.5)<1 OR INT(I+.5)>8 OR INT(J+.5)<1 OR INT(J+.5)>8 THEN 6540
6490 A$=">!<":Z1=I:Z2=J:GOSUB 8830:IF Z3=1 THEN D0=1
6540 NEXT J:NEXT I:IF D0=0 THEN 6650
6580 C$="DOCKED":E=E0:P=P0
6620 IF S>0 THEN M$="SHIELDS DROPPED FOR DOCKING PURPOSES":GOSUB 8000
6630 S=0:RETURN
6650 IF K3>0 THEN C$="RED":RETURN
6660 C$="GREEN":IF E<E0*.1 THEN C$="YELLOW"
6670 RETURN
6990 REM UPDATE THE WHOLE DISPLAY
7000 GOSUB 7020:GOSUB 7100:IF MV=0 THEN GOSUB 7300:RETURN
7010 GOSUB 7400:RETURN
7015 REM STATUS PANEL
7020 U$=STR$(INT(T*10)/10)+NL$+C$+NL$+STR$(Q1)+" , "+STR$(Q2)+NL$+STR$(S1)+" , "+STR$(S2)+NL$+STR$(P):GFX_TEXT(HA,U$)
7030 U$=STR$(INT(E))+NL$+STR$(INT(S))+NL$+STR$(K9)+NL$+STR$(B9)+NL$+STR$(INT((T0+T9-T)*10)/10):GFX_TEXT(HD,U$)
7040 U=GFX_RGB(&H43A047):IF C$="RED" THEN U=GFX_RGB(&HE53935)
7050 IF C$="YELLOW" THEN U=GFX_RGB(&HFDD835)
7060 IF C$="DOCKED" THEN U=GFX_RGB(&H1E88E5)
7070 GFX_BG_COLOR(HQ,U):RETURN
7090 REM SHORT RANGE SENSOR SCAN: MOVE THE SECTOR MARKERS
7100 IF D(2)>=0 THEN 7120
7110 FOR U3=1 TO 3:GFX_HIDE(HK(U3)):NEXT U3:FOR U3=1 TO 8:GFX_HIDE(HS(U3)):NEXT U3:GFX_HIDE(BH):GFX_HIDE(EH):RETURN
7120 U1=S1:U2=S2:U=EH:U5=34:GOSUB 7190:IF ED=0 THEN GFX_SHOW(EH)
7125 IF ED<>0 THEN GFX_HIDE(EH)
7130 U5=30:FOR U3=1 TO 3:U=HK(U3):IF K(U3,3)<=0 THEN GFX_HIDE(U)
7135 IF K(U3,3)>0 THEN U1=K(U3,1):U2=K(U3,2):GOSUB 7190:GFX_SHOW(U)
7140 NEXT U3:IF B3<=0 THEN GFX_HIDE(BH)
7145 IF B3>0 THEN U1=B4:U2=B5:U=BH:U5=36:GOSUB 7190:GFX_SHOW(BH)
7150 U3=0:U5=12:FOR U4=1 TO 64:IF MID$(Q$,U4*3-2,3)=" * " THEN U3=U3+1:U1=INT((U4-1)/8)+1:U2=U4-(U1-1)*8:U=HS(U3):GOSUB 7190:GFX_SHOW(U)
7160 NEXT U4:FOR U4=U3+1 TO 8:GFX_HIDE(HS(U4)):NEXT U4:RETURN
7170 REM TORPEDO STEP, MARKER PLACEMENT (U AT ROW U1 COLUMN U2, SIZE U5)
7180 U=TP:U5=10:GOSUB 7190:GFX_SHOW(TP):SLEEP .12:RETURN
7190 GFX_SET_POS(U,GX+(U2-1)*48+INT((48-U5)/2),GY+(U1-1)*48+INT((48-U5)/2)):RETURN
7200 GFX_BG_COLOR(HK(U),GFX_RGB(&HFFFFFF)):SLEEP .15:GFX_BG_COLOR(HK(U),KC):RETURN
7210 GFX_BG_COLOR(EH,KC):SLEEP .15:GFX_BG_COLOR(EH,EC):RETURN
7290 REM CUMULATIVE GALACTIC RECORD MAP
