{
  "name": "basicedge-desktop",
  "version": "1.0.0",
  "description": "Desktop emulator for the BasicEdge PSOC Edge BASIC firmware",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test": "node scripts/build.mjs --tests && node --test dist-test/*.test.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
